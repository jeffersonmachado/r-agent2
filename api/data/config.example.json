{
  "api": {
    "port": 3000,
    "sessionTimeout": 3600000,
    "maxRetries": 3
  },
  "chatbot": {
    "defaultFlowId": "flow-welcome",
    "enableFallback": true,
    "fallbackMaxAttempts": 3,
    "enableEmotionCheck": true
  },
  "queues": {
    "defaultQueue": "suporte",
    "autoAssign": true,
    "maxTicketsPerAgent": 10
  },
  "features": {
    "enableRAG": false,
    "enableWebhooks": true,
    "enableBulkMessaging": false
  },
  "pbx": {
    "legacy": {
      "root": "/opt/results/telefonia/ripabx",
      "xmlDir": "/opt/results/telefonia/ripabx/dados/xml",
      "binDir": "/opt/results/telefonia/ripabx/bin",
      "cgiDir": "/opt/results/telefonia/ripabx/cgi-bin",
      "asteriskConfigDir": "/opt/results/telefonia/ripabx/etc/asterisk"
    },
    "mariadb": {
      "url": "mysql://USER:PASS@HOST:3306/results"
    }
  },
  "ai": {
    "openai": {
      "model": "gpt-5.2"
    },
    "anthropic": {
      "model": "claude-3-sonnet-20240229"
    }
  },
  "NOTE": "apiKey não deve estar neste arquivo. Use OPENAI_API_KEY via env ou tenant_ai_credentials no banco."
}
