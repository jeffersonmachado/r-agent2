{
  "version": "1.0.0",
  "lastUpdated": "2026-01-05T17:00:00.000Z",
  "description": "Regras editáveis para geração automática de perguntas a partir de documentos RAG",
  "titleBased": {
    "enabled": true,
    "minTitleLength": 3,
    "excludedWords": [
      "como",
      "para",
      "sobre",
      "guia",
      "manual",
      "documento",
      "arquivo"
    ],
    "templates": [
      "O que é {{mainTopic}}?",
      "Como funciona {{mainTopic}}?"
    ],
    "maxQuestionsFromTitle": 2
  },
  "keywordPatterns": {
    "enabled": true,
    "patterns": [
      {
        "pattern": "senha|password",
        "questions": [
          "Como resetar minha senha?",
          "Como alterar minha senha?",
          "Esqueci minha senha"
        ]
      },
      {
        "pattern": "conta|account",
        "questions": [
          "Como criar uma conta?",
          "Como cancelar minha conta?",
          "Como fechar minha conta?"
        ]
      },
      {
        "pattern": "pagamento|payment|pagar",
        "questions": [
          "Como fazer um pagamento?",
          "Quais são as formas de pagamento?",
          "Como pagar?"
        ]
      },
      {
        "pattern": "suporte|support|ajuda|help",
        "questions": [
          "Como entrar em contato com o suporte?",
          "Onde posso obter ajuda?",
          "Preciso de ajuda"
        ]
      },
      {
        "pattern": "produto|product",
        "questions": [
          "Quais produtos estão disponíveis?",
          "Como comprar um produto?",
          "Informações sobre produtos"
        ]
      },
      {
        "pattern": "ticket|chamado",
        "questions": [
          "Como abrir um ticket?",
          "Como acompanhar meu ticket?",
          "Abrir chamado"
        ]
      },
      {
        "pattern": "configuração|config|settings",
        "questions": [
          "Como configurar?",
          "Onde estão as configurações?",
          "Configurações do sistema"
        ]
      },
      {
        "pattern": "resetar|reset",
        "questions": [
          "Como resetar?",
          "Resetar configurações"
        ]
      },
      {
        "pattern": "instalar|instalação",
        "questions": [
          "Como instalar?",
          "Instruções de instalação"
        ]
      },
      {
        "pattern": "erro|error|problema",
        "questions": [
          "Como resolver este problema?",
          "O que fazer quando ocorre erro?"
        ]
      }
    ]
  },
  "contentBased": {
    "enabled": true,
    "minContentLength": 50,
    "actionVerbs": [
      "acesse",
      "clique",
      "selecione",
      "digite",
      "insira",
      "configure",
      "ativar",
      "desativar"
    ],
    "sentenceFilters": {
      "minLength": 20,
      "maxLength": 150
    },
    "maxSentencesToProcess": 3,
    "questionTemplate": "Como {{action}}?",
    "fallbackEnabled": true,
    "fallbackMaxSentences": 2,
    "fallbackMinLength": 20,
    "fallbackMaxLength": 100
  },
  "deduplication": {
    "enabled": true,
    "similarityThreshold": 0.8,
    "normalizeForComparison": true
  },
  "limits": {
    "maxQuestionsPerDocument": 5,
    "maxQuestionsFromTitle": 2,
    "maxQuestionsFromKeywords": 10,
    "maxQuestionsFromContent": 5
  }
}

