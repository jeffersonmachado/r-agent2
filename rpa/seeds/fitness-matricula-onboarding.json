{
  "id": "fitness-matricula-onboarding",
  "name": "Fitness Matrícula — Onboarding do Novo Aluno",
  "version": "2.0.0",
  "metadata": {
    "autoLogin": true,
    "vertical": "fitness",
    "journey": "onboarding",
    "purpose": "Jornada operacional real de onboarding dirigida pela UI de negócio (tela Alunos Fitness): abre a tela real, preenche o formulário Novo Aluno, confirma o cadastro até o toast 'Aluno criado com sucesso' e prova a LEITURA APÓS ESCRITA buscando o aluno recém-criado e validando a linha na tabela. Substitui o stub v1.2.0, que navegava para /dev/qa-waves (tela de QA, proibida numa jornada de negócio) e /support (superfície deprecada) com assert trivial em <body>."
  },
  "steps": [
    {
      "name": "Abrir workspace (login automático pousa aqui)",
      "type": "navigate",
      "url": "{{urls.frontend}}/workspace"
    },
    {
      "name": "Aguardar shell autenticado",
      "type": "wait",
      "critical": false,
      "selector": ".rap-primary-rail",
      "timeout": 20000
    },
    {
      "name": "Abrir a tela real de Alunos Fitness",
      "type": "navigate",
      "url": "{{urls.frontend}}/fitness/students"
    },
    {
      "name": "Aguardar cabeçalho da tela de alunos",
      "type": "wait",
      "critical": false,
      "selector": "h1:has-text(\"Alunos Fitness\")",
      "timeout": 20000
    },
    {
      "name": "Aguardar resumo operacional (Total/Liberados/Em alerta/Bloqueados)",
      "type": "wait",
      "critical": false,
      "selector": ".support-details-panel strong:has-text(\"Liberados\")",
      "timeout": 15000
    },
    {
      "name": "Abrir formulário de novo aluno",
      "type": "click",
      "critical": false,
      "selector": "button:has-text(\"Novo Aluno\")",
      "timeout": 10000
    },
    {
      "name": "Aguardar formulário Novo Aluno",
      "type": "wait",
      "critical": false,
      "selector": "h3:has-text(\"Novo Aluno\")",
      "timeout": 10000
    },
    {
      "name": "Preencher nome do aluno",
      "type": "fill",
      "critical": false,
      "selector": "input[placeholder=\"Nome completo\"]",
      "value": "Aluno Onboarding QA",
      "timeout": 10000
    },
    {
      "name": "Preencher telefone do aluno",
      "type": "fill",
      "critical": false,
      "selector": "input[placeholder=\"+5511...\"]",
      "value": "+5511988887777",
      "timeout": 10000
    },
    {
      "name": "Confirmar cadastro do aluno",
      "type": "click",
      "critical": false,
      "selector": "button:has-text(\"Criar aluno\")",
      "timeout": 10000
    },
    {
      "name": "Aguardar confirmação de cadastro (prova a escrita real)",
      "type": "wait",
      "critical": false,
      "selector": ".rap-toast--success:has-text(\"Aluno criado com sucesso\")",
      "timeout": 20000
    },
    {
      "name": "Buscar o aluno recém-criado",
      "type": "fill",
      "critical": false,
      "selector": "input[placeholder=\"Nome, documento, telefone ou código\"]",
      "value": "Aluno Onboarding QA",
      "timeout": 10000
    },
    {
      "name": "Executar a busca",
      "type": "click",
      "critical": false,
      "selector": "button:has-text(\"Buscar\")",
      "timeout": 10000
    },
    {
      "name": "Validar que o aluno aparece na tela operacional (leitura após escrita)",
      "type": "assert",
      "page": {
        "landmarks": [
          {
            "selector": "td:has-text(\"Aluno Onboarding QA\")",
            "exists": true
          }
        ]
      }
    }
  ],
  "data": {
    "journey": "onboarding",
    "vertical": "fitness"
  }
}