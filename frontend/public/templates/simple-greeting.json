{
  "id": "simple-greeting",
  "name": "Saudação Simples",
  "description": "Fluxo básico com uma mensagem de boas-vindas e fallback integrado",
  "icon": "👋",
  "flow": {
    "tenantId": "tenant-demo",
    "id": "simple-greeting",
    "name": "Saudação Simples",
    "version": 1,
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "config": {},
        "next": "greeting"
      },
      {
        "id": "greeting",
        "type": "message",
        "config": {
          "text": "Olá! Bem-vindo ao nosso chatbot. Como posso ajudá-lo hoje?"
        },
        "next": "fallback"
      },
      {
        "id": "fallback",
        "type": "fallback",
        "config": {
          "maxAttempts": 3,
          "confidenceThreshold": 0.75,
          "enableEmotionCheck": true,
          "escalationMode": "ticket",
          "allowReturnToBot": true,
          "queue": "default",
          "safeReturnNode": "greeting"
        },
        "next": {
          "retry": "greeting",
          "options": "greeting",
          "human": "end",
          "end": "end"
        }
      },
      {
        "id": "end",
        "type": "end",
        "config": {},
        "next": null
      }
    ],
    "metadata": {
      "description": "Template básico com fallback para garantir resiliência"
    }
  }
}

