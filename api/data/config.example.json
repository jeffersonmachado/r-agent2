{
  "api": {
    "port": 3000,
    "sessionTimeout": 3600000,
    "maxRetries": 3
  },
  "chatbot": {
    "defaultFlowId": "flow-welcome",
    "enableFallback": true,
    "fallbackMaxAttempts": 3,
    "enableEmotionCheck": true
  },
  "queues": {
    "defaultQueue": "suporte",
    "autoAssign": true,
    "maxTicketsPerAgent": 10
  },
  "features": {
    "enableRAG": false,
    "enableWebhooks": true,
    "enableBulkMessaging": false
  },
  "billing": {
    "provider": "asaas",
    "providers": {
      "asaas": {
        "baseUrl": "https://api.asaas.com/v3",
        "apiKey": "REPLACE_WITH_ASAAS_API_KEY",
        "webhookSecret": "REPLACE_WITH_ASAAS_WEBHOOK_SECRET_GERAR_COM_node_-e_console.log_require_crypto_randomBytes_32_toString_hex", 
        "billingType": "PIX"
      },
      "mercadoPago": {
        "baseUrl": "https://api.mercadopago.com",
        "accessToken": "REPLACE_WITH_MP_ACCESS_TOKEN",
        "webhookSecret": "REPLACE_WITH_MP_WEBHOOK_SECRET_GERAR_COM_node_-e_console.log_require_crypto_randomBytes_32_toString_hex"
      }
    }
  },
  "notifications": {
    "whatsapp": {
      "enabled": false
    },
    "sms": {
      "enabled": false
    },
    "email": {
      "enabled": false
    }
  },
  "whatsapp": {
    "apiUrl": "https://graph.facebook.com/v18.0",
    "phoneNumberId": "REPLACE_WITH_PHONE_NUMBER_ID",
    "accessToken": "REPLACE_WITH_WHATSAPP_ACCESS_TOKEN",
    "verifyToken": "REPLACE_WITH_WHATSAPP_VERIFY_TOKEN"
  },
  "pbx": {
    "legacy": {
      "root": "/opt/results/telefonia/ripabx",
      "xmlDir": "/opt/results/telefonia/ripabx/dados/xml",
      "binDir": "/opt/results/telefonia/ripabx/bin",
      "cgiDir": "/opt/results/telefonia/ripabx/cgi-bin",
      "asteriskConfigDir": "/opt/results/telefonia/ripabx/etc/asterisk"
    },
    "mariadb": {
      "url": "mysql://USER:PASS@HOST:3306/results"
    }
  },
  "webhooks": {
    "whatsappQrSecret": "REPLACE_WITH_WHATSAPP_QR_WEBHOOK_SECRET_GERAR_COM_node_-e_console.log_require_crypto_randomBytes_32_toString_hex"
  },
  "instagram": {
    "appSecret": "REPLACE_WITH_INSTAGRAM_APP_SECRET_OBTER_NO_META_DEVELOPER_DASHBOARD"
  },
  "messenger": {
    "appSecret": "REPLACE_WITH_MESSENGER_APP_SECRET_OBTER_NO_META_DEVELOPER_DASHBOARD"
  },
  "ai": {
    "openai": {
      "model": "gpt-5.2"
    },
    "anthropic": {
      "model": "claude-3-sonnet-20240229"
    }
  },
  "NOTE": "apiKey não deve estar neste arquivo. Use OPENAI_API_KEY via env ou tenant_ai_credentials no banco."
}
