{
  "id": "random-number-example",
  "name": "Exemplo de Número Aleatório",
  "description": "Exemplo de uso do nó random_number para gerar números aleatórios",
  "icon": "🎲",
  "flow": {
    "tenantId": "<tenant-id>",
    "id": "random-number-example",
    "name": "Exemplo de Número Aleatório",
    "version": 1,
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "config": {},
        "next": "welcome"
      },
      {
        "id": "welcome",
        "type": "message",
        "config": {
          "text": "Olá! Vou gerar um número aleatório entre 1 e 100 para você."
        },
        "next": "generate-random"
      },
      {
        "id": "generate-random",
        "type": "random_number",
        "config": {
          "min": 1,
          "max": 100,
          "outputVariable": "random_number"
        },
        "next": "show-result"
      },
      {
        "id": "show-result",
        "type": "message",
        "config": {
          "text": "O número aleatório gerado foi: {{random_number}}"
        },
        "next": "end"
      },
      {
        "id": "end",
        "type": "end",
        "config": {},
        "next": null
      }
    ],
    "metadata": {
      "description": "Template demonstrando uso do nó random_number para gerar números aleatórios"
    }
  }
}

