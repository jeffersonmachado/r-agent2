{
  "id": "fitness-matricula-checkout",
  "name": "Fitness Matrícula — Checkout e Pagamento",
  "version": "2.0.0",
  "metadata": {
    "autoLogin": true,
    "vertical": "fitness",
    "journey": "checkout",
    "purpose": "Jornada operacional real de checkout dirigida pela UI de negócio (tela Alunos Fitness): cria um aluno determinístico, executa Check-in (pré-condição de uma presença aberta) e em seguida o Check-out, provando o ciclo completo de presença até o toast 'Check-out realizado'. Substitui o stub v1.2.0, que navegava para /dev/qa-waves (tela de QA, proibida numa jornada de negócio) e /support (superfície deprecada) com assert trivial em <body>."
  },
  "steps": [
    {
      "name": "Abrir workspace (login automático pousa aqui)",
      "type": "navigate",
      "url": "{{urls.frontend}}/workspace"
    },
    {
      "name": "Aguardar shell autenticado",
      "type": "wait",
      "critical": false,
      "selector": ".rap-primary-rail",
      "timeout": 20000
    },
    {
      "name": "Abrir a tela real de Alunos Fitness",
      "type": "navigate",
      "url": "{{urls.frontend}}/fitness/students"
    },
    {
      "name": "Aguardar cabeçalho da tela de alunos",
      "type": "wait",
      "critical": false,
      "selector": "h1:has-text(\"Alunos Fitness\")",
      "timeout": 20000
    },
    {
      "name": "Abrir formulário de novo aluno (fixture determinística do checkout)",
      "type": "click",
      "critical": false,
      "selector": "button:has-text(\"Novo Aluno\")",
      "timeout": 10000
    },
    {
      "name": "Aguardar formulário Novo Aluno",
      "type": "wait",
      "critical": false,
      "selector": "h3:has-text(\"Novo Aluno\")",
      "timeout": 10000
    },
    {
      "name": "Preencher nome do aluno",
      "type": "fill",
      "critical": false,
      "selector": "input[placeholder=\"Nome completo\"]",
      "value": "Aluno Checkout QA",
      "timeout": 10000
    },
    {
      "name": "Confirmar cadastro do aluno",
      "type": "click",
      "critical": false,
      "selector": "button:has-text(\"Criar aluno\")",
      "timeout": 10000
    },
    {
      "name": "Aguardar confirmação de cadastro",
      "type": "wait",
      "critical": false,
      "selector": ".rap-toast--success:has-text(\"Aluno criado com sucesso\")",
      "timeout": 20000
    },
    {
      "name": "Buscar o aluno",
      "type": "fill",
      "critical": false,
      "selector": "input[placeholder=\"Nome, documento, telefone ou código\"]",
      "value": "Aluno Checkout QA",
      "timeout": 10000
    },
    {
      "name": "Executar a busca",
      "type": "click",
      "critical": false,
      "selector": "button:has-text(\"Buscar\")",
      "timeout": 10000
    },
    {
      "name": "Abrir a ficha operacional do aluno",
      "type": "click",
      "critical": false,
      "selector": "table.support-table button:has-text(\"Abrir\")",
      "timeout": 15000
    },
    {
      "name": "Aguardar a ficha operacional carregada com dados vivos",
      "type": "wait",
      "critical": false,
      "selector": "strong:has-text(\"Frequencia 7d / 30d:\")",
      "timeout": 20000
    },
    {
      "name": "Executar o Check-in (pré-condição da presença aberta)",
      "type": "click",
      "critical": false,
      "selector": "button:has-text(\"Check-in\")",
      "timeout": 10000
    },
    {
      "name": "Aguardar confirmação do check-in",
      "type": "wait",
      "critical": false,
      "selector": ".rap-toast--success:has-text(\"Check-in realizado\")",
      "timeout": 20000
    },
    {
      "name": "Executar o Check-out",
      "type": "click",
      "critical": false,
      "selector": "button:has-text(\"Check-out\")",
      "timeout": 10000
    },
    {
      "name": "Aguardar confirmação do check-out",
      "type": "wait",
      "critical": false,
      "selector": ".rap-toast--success:has-text(\"Check-out realizado\")",
      "timeout": 20000
    },
    {
      "name": "Validar que a ficha operacional permanece íntegra após o ciclo de presença",
      "type": "assert",
      "page": {
        "landmarks": [
          {
            "selector": "strong:has-text(\"Churn score:\")",
            "exists": true
          }
        ]
      }
    }
  ],
  "data": {
    "journey": "checkout",
    "vertical": "fitness"
  }
}