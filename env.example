NOTIFICATION_EMAIL_ENABLED=false
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=qa@example.test
EMAIL_FROM_NAME=QA Waves
# ============================================================================
# .env — Variáveis de ambiente do Results Autonomous Platform (RAP)
#
# SETUP:
#   cp env.example .env
#   # Preencha o ENCRYPTION_KEY obrigatório; demais são opcionais.
#
# CONFIG PRINCIPAL: api/data/config.json
#   cp api/data/config.example.json api/data/config.json
#   # Edite api/data/config.json para ajustar ports, integrações e features.
#
# OBSERVAÇÃO: ENV é suportado como override operacional e compatibilidade.
#   Para ambientes novos, prefira api/data/config.json para produto e use ENV
#   para paths de runtime, conectividade e credenciais injetadas pelo ambiente.
# ============================================================================

# ============================================================================
# CRIPTOGRAFIA DE SEGREDOS (OBRIGATÓRIO para salvar credenciais de IA)
# ============================================================================
# A API usa ENCRYPTION_KEY para criptografar segredos no banco (ex.: API keys).
# Deve ser exatamente 32 bytes em base64.
#
# Gerar localmente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ou:
#   openssl rand -base64 32
#
# IMPORTANTE: Não troque esta chave depois que já existirem segredos salvos,
# senão não será possível descriptografá-los.
ENCRYPTION_KEY=

# ============================================================================
# RUNTIME — NODE_ENV e PORTS (fallback; preferir config.json)
# ============================================================================
# NODE_ENV=development
# API_PORT=3000
# FRONTEND_PORT=8080
# VITE_API_BASE_URL=http://localhost:3000

# ============================================================================
# BANCO DE DADOS (obrigatório se não configurado em config.json)
# ============================================================================
# DATABASE_URL=postgres://usuario:senha@localhost:5432/r_agent2

# ============================================================================
# WHATSAPP / WEBHOOKS (opcional; configurable via config.json)
# ============================================================================
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0
# WHATSAPP_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID
# WHATSAPP_ACCESS_TOKEN=SEU_ACCESS_TOKEN
# WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao_webhook
# WHATSAPP_QR_PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# PUPPETEER_CACHE_DIR=/app/.cache/puppeteer

# ============================================================================
# RUNTIME PATHS (recomendado em produção/container)
# ============================================================================
# WWEBJS_AUTH_PATH=/var/lib/ragent2/whatsapp/auth
# QA_MESH_HISTORY_DIR=/var/lib/ragent2/qa-mesh/history
# QA_MESH_EVIDENCE_DIR=/var/lib/ragent2/qa-mesh/evidence
# RUNTIME_ROOT=/var/lib/ragent2/runtime
# QA_MESH_SYSTEM_VALIDATE_DIR=/var/lib/ragent2/qa-mesh/system-validate
# RELEASE_EVIDENCE_BASE_DIR=/var/lib/ragent2/release-evidence
# RAG_DATA_ROOT=/var/lib/ragent2/rag
# VECTOR_STORE_PATH=/var/lib/ragent2/rag/vector_store
# ADAPTIVE_LEARNING_DATA_PATH=/var/lib/ragent2/rag/adaptive_learning

# ============================================================================
# RAG SERVICE — autenticação serviço-a-serviço (obrigatória em produção)
# O mesmo valor deve existir no .env do backend (Node) e no rag-service/.env
# (Python). Sem ele, o rag-service aceita chamadas sem autenticação (dev only).
# ============================================================================
# RAG_INTERNAL_TOKEN= gere-com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================================================
# RATE LIMITING (Redis — fallback; preferir config.json rateLimit.redis)
# ============================================================================
# REDIS_URL=redis://localhost:6379
# RATE_LIMIT_REDIS_URL=redis://localhost:6379

# ============================================================================
# SCRAPING (opcionais — remover fallback silencioso exige config explícita)
# ============================================================================
# SCRAPING_ALLOW_DEGRADED=false     # false = falha explícita se cheerio ausente
# USE_PLAYWRIGHT=false
# ENABLE_SCRAPING_REPLAY=false
# ENABLE_SCRAPING_RECORDING=false

# ============================================================================
# PBX LEGADO (Ripabx / r-pbx) — opcional
# ============================================================================
# PBX_LEGACY_ROOT=/opt/results/telefonia/ripabx
# PBX_MARIADB_URL=mysql://resultsdba:*****@ripabx-mariadb:3306/results

# ============================================================================
# IA / GOVERNANÇA
# ============================================================================
# Provider principal/secundário do tenant é configurado no banco.
# O provider secundário só entra em execução se fallbacks.aiProviderSecondary=true
# estiver configurado explicitamente no config.json.
