# ============================================================================
# NOTA: Este arquivo está DEPRECADO
# ============================================================================
# Todas as configurações foram migradas para api/data/config.json
# 
# Para configurar o sistema:
# 1. Copie api/data/config.example.json para api/data/config.json
# 2. Edite api/data/config.json com suas configurações
#
# O sistema ainda suporta variáveis de ambiente como fallback para
# compatibilidade, mas recomenda-se usar config.json
# ============================================================================

# Variáveis de ambiente ainda suportadas (fallback):
# NODE_ENV=production
# API_PORT=3000
# DEFAULT_TENANT_ID removido - tenant deve ser fornecido via autenticação
# FRONTEND_PORT=8080
# VITE_API_BASE_URL=http://localhost:3000
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0
# WHATSAPP_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID
# WHATSAPP_ACCESS_TOKEN=SEU_ACCESS_TOKEN
# WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao_webhook
# DEFAULT_FLOW_ID=ID_DO_FLUXO_PADRAO
# TICKET_CLEANUP_INTERVAL_HOURS=1
# TICKET_MAX_AGE_DAYS=7

# ============================================================================
# RATE LIMITING (Redis)
# ============================================================================
# NOTA: A configuração principal está em api/data/config.json
# As variáveis de ambiente abaixo são usadas apenas como FALLBACK
# se não estiverem definidas no config.json
#
# Para configurar rate limiting, edite api/data/config.json:
# {
#   "rateLimit": {
#     "redis": { "url": "redis://localhost:6379" },
#     "policies": { ... }
#   }
# }
# ============================================================================

# URL do Redis para rate limiting (fallback se não estiver no config.json)
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# Políticas de Rate Limiting (fallback se não estiverem no config.json)
# RATE_LIMIT_DRY_RUN_POINTS=50          # Execuções DRY-RUN por janela
# RATE_LIMIT_DRY_RUN_DURATION=60        # Janela em segundos
# RATE_LIMIT_GENERATION_POINTS=5        # Execuções reais por janela
# RATE_LIMIT_GENERATION_DURATION=60     # Janela em segundos
# RATE_LIMIT_BOOTSTRAP_POINTS=1         # Execuções bootstrap por janela
# RATE_LIMIT_BOOTSTRAP_DURATION=300     # Janela em segundos (5 minutos)
# RATE_LIMIT_SCRAPING_POINTS=10         # Requisições de scraping por janela
# RATE_LIMIT_SCRAPING_DURATION=300      # Janela em segundos
# RATE_LIMIT_SCRAPING_RPS=3             # Requisições por segundo por domínio
# RATE_LIMIT_SCRAPING_PAGES=20          # Máximo de páginas por execução

