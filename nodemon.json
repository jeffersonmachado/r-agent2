{
  "watch": [
    "api",
    "engine",
    "src",
    "qa-mesh"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules",
    "frontend",
    "logs",
    "tests/rpa/flows",
    "tests/rpa/flows/**",
    "tests/rpa/reports",
    "tests/rpa/reports/**",
    "tests/rpa/replay",
    "tests/rpa/replay/**",
    "tests/rpa/screenshots",
    "tests/rpa/screenshots/**",
    "tests/rpa/.cache",
    "tests/rpa/.cache/**",
    "qa-mesh/meshHistory",
    "qa-mesh/meshHistory/**",
    "qa-mesh/meshEvidence",
    "qa-mesh/meshEvidence/**",
    "qa-mesh/intelligence",
    "qa-mesh/intelligence/**",
    "qa-mesh/meshRegistry*.json",
    "qa-mesh/baseline.json",
    "qa-mesh/canonical-promotion.json",
    "qa-mesh/go-no-go-report.json",
    "qa-mesh/meshReport.json",
    "qa-mesh/metrics.json",
    "qa-mesh/repairPlan.json",
    "qa-mesh/release-gate-report.json",
    "qa-mesh/scheduler-state.json",
    "qa-mesh/scheduler-activity.log",
    "*.test.js",
    "*.spec.js"
  ],
  "exec": "node api/server.js",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "restartable": "rs"
}