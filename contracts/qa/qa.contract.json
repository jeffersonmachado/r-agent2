{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://r-agent2/contracts/qa/qa.contract.json",
  "title": "Contrato de QA - Tipos de Teste Obrigatórios",
  "description": "Define tipos de teste obrigatórios incluindo RPA como mecanismo de teste",
  "version": "1.0.0",
  "qa": {
    "requiredTestTypes": {
      "type": "array",
      "description": "Tipos de teste obrigatórios no sistema",
      "items": {
        "type": "string",
        "enum": ["unit", "flow", "stress", "rpa"]
      },
      "default": ["unit", "flow", "stress", "rpa"],
      "uniqueItems": true
    },
    "rpa": {
      "description": "Configurações específicas de testes RPA",
      "mandatoryFor": {
        "type": "array",
        "description": "Componentes que DEVEM possuir testes RPA",
        "items": {
          "type": "string",
          "enum": ["frontend", "chatbot-flows"]
        },
        "default": ["frontend", "chatbot-flows"],
        "uniqueItems": true
      },
      "generation": {
        "description": "Regras de geração de testes RPA por IA",
        "allowedSources": {
          "type": "array",
          "description": "Fontes permitidas para geração de testes RPA",
          "items": {
            "type": "string",
            "enum": ["rag", "scraping"]
          },
          "default": ["rag", "scraping"],
          "uniqueItems": true
        },
        "scrapingRequiresApproval": {
          "type": "boolean",
          "description": "Se true, raspagem de sites requer aprovação/auditoria",
          "default": true
        }
      },
      "execution": {
        "description": "Regras de execução de testes RPA",
        "blockingOnFailure": {
          "type": "boolean",
          "description": "Se true, falha em teste RPA bloqueia pipeline (salvo política explícita)",
          "default": true
        },
        "reportLocation": {
          "type": "string",
          "description": "Localização dos relatórios de testes RPA",
          "default": "/tests/rpa/reports"
        }
      }
    },
    "rag": {
      "description": "Configurações de validação RAG",
      "requiredWhenEnabled": {
        "type": "boolean",
        "description": "Se true, RAG é obrigatório quando useRag=true",
        "default": true
      },
      "minSources": {
        "type": "number",
        "description": "Quantidade mínima de fontes RAG requeridas",
        "default": 3,
        "minimum": 1
      },
      "validation": {
        "description": "Regras de validação RAG",
        "blockingOnFailure": {
          "type": "boolean",
          "description": "Se true, falha em validação RAG bloqueia pipeline",
          "default": true
        },
        "checks": {
          "type": "array",
          "description": "Lista de checks obrigatórios",
          "items": {
            "type": "string",
            "enum": [
              "ragContextBuilt",
              "ragContextAvailable",
              "minChunks",
              "minSources",
              "aiDeclaredUsage",
              "aiDeclaredSources"
            ]
          },
          "default": [
            "ragContextBuilt",
            "ragContextAvailable",
            "minChunks",
            "minSources",
            "aiDeclaredUsage",
            "aiDeclaredSources"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}

