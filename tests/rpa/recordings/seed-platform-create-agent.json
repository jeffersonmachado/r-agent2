{
  "id": "seed-platform-create-agent",
  "name": "Seed Plataforma - Criar Agente",
  "version": "1.0.0",
  "createdAt": "2026-01-02T00:00:00.000Z",
  "url": "http://localhost:5173",
  "steps": [
    {
      "type": "navigate",
      "url": "{{urls.frontend}}/agents",
      "waitFor": ".agents-page, [data-testid='agents-page']",
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:00.000Z"
    },
    {
      "type": "wait",
      "condition": 2000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:01.000Z"
    },
    {
      "type": "click",
      "selector": "button:has-text('Novo Agente'), button:has-text('Criar Agente'), [data-testid='create-agent-button']",
      "waitFor": "input[name='username'], input[placeholder*='usuário'], .agent-form",
      "timeout": 30000,
      "force": false,
      "timestamp": "2026-01-02T00:00:02.000Z"
    },
    {
      "type": "wait",
      "condition": 1000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:03.000Z"
    },
    {
      "type": "fill",
      "selector": "input[name='username'], input[placeholder*='usuário']",
      "value": "{{agent.username}}",
      "clear": true,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:04.000Z"
    },
    {
      "type": "fill",
      "selector": "input[name='email'], input[type='email']",
      "value": "{{agent.email}}",
      "clear": true,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:05.000Z"
    },
    {
      "type": "fill",
      "selector": "input[name='password'], input[type='password']",
      "value": "{{agent.password}}",
      "clear": true,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:06.000Z"
    },
    {
      "type": "select",
      "selector": "select[name='role'], select[data-testid='role-select']",
      "value": "{{agent.role}}",
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:07.000Z"
    },
    {
      "type": "wait",
      "condition": 500,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:08.000Z"
    },
    {
      "type": "click",
      "selector": "button:has-text('Criar'), button:has-text('Salvar'), button[type='submit']",
      "waitFor": ".agents-list, [data-testid='agents-list']",
      "timeout": 30000,
      "force": false,
      "timestamp": "2026-01-02T00:00:09.000Z"
    },
    {
      "type": "wait",
      "condition": 2000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:10.000Z"
    },
    {
      "type": "assert",
      "selector": ".agents-list, [data-testid='agents-list']",
      "exists": true,
      "message": "Agente criado com sucesso",
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:11.000Z"
    }
  ],
  "data": {
    "agent": {
      "username": "novo-agente",
      "email": "novo@example.com",
      "password": "senha123",
      "role": "agent"
    },
    "urls": {
      "frontend": "http://localhost:5173"
    }
  }
}

