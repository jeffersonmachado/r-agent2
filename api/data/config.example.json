{
  "nodeEnv": "production",
  "api": {
    "port": 3000,
    "baseUrl": "http://localhost:3000",
    "defaultTenantId": "tenant-demo",
    "ticketCleanup": {
      "intervalHours": 1,
      "maxAgeDays": 7
    }
  },
  "frontend": {
    "port": 5173,
    "url": "http://localhost:5173",
    "apiBaseUrl": "http://localhost:3000"
  },
  "whatsapp": {
    "apiUrl": "https://graph.facebook.com/v18.0",
    "phoneNumberId": "SEU_PHONE_NUMBER_ID",
    "accessToken": "SEU_ACCESS_TOKEN",
    "verifyToken": "seu_token_de_verificacao_webhook"
  },
  "flows": {
    "defaultFlowId": "ID_DO_FLUXO_PADRAO"
  },
  "ai": {
    "defaultProvider": "openai",
    "defaultFallback": "fallback",
    "openai": {
      "apiKey": "sk-sua-chave-api-openai-aqui",
      "model": "gpt-5.2"
    },
    "anthropic": {
      "apiKey": "sk-ant-sua-chave-api-anthropic-aqui",
      "model": "claude-3-sonnet-20240229"
    },
    "tenants": {
      "tenant-demo": {
        "primary": "openai",
        "fallback": "fallback"
      }
    }
  },
  "scripts": {
    "apiUrl": "http://localhost:3000",
    "maxAgeDays": 7,
    "dryRun": false
  },
  "features": {
    "aiTasksEnabled": true,
    "useRealAiApi": false
  },
  "logging": {
    "level": "INFO",
    "format": "json"
  },
  "tests": {
    "rpa": {
      "frontendUrl": "http://localhost:5173",
      "apiUrl": "http://localhost:3000"
    }
  },
  "rateLimit": {
    "redis": {
      "url": "redis://localhost:6379"
    },
    "policies": {
      "dryRun": {
        "points": 50,
        "duration": 60
      },
      "generation": {
        "points": 5,
        "duration": 60
      },
      "bootstrap": {
        "points": 1,
        "duration": 300
      },
      "scraping": {
        "points": 10,
        "duration": 300,
        "requestsPerSecond": 3,
        "pagesPerExecution": 20
      },
      "systemValidate": {
        "points": 10,
        "duration": 60
      }
    }
  }
}

