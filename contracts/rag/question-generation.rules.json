{
  "version": "1.1.0",
  "lastUpdated": "2026-01-30T00:00:00.000Z",
  "description": "Regras editáveis para geração automática de perguntas a partir de documentos RAG (com cobertura de domínio)",
  "titleBased": {
    "enabled": true,
    "minTitleLength": 3,
    "excludedWords": ["como", "para", "sobre", "guia", "manual", "documento", "arquivo"],
    "templates": ["O que é {{mainTopic}}?", "Como funciona {{mainTopic}}?"],
    "maxQuestionsFromTitle": 2
  },
  "keywordPatterns": {
    "enabled": true,
    "patterns": [
      {
        "pattern": "pagamento|payment|pagar|pix",
        "questions": ["Quais formas de pagamento são aceitas?", "Posso pagar via PIX?", "Como enviar o comprovante?"]
      },
      {
        "pattern": "whatsapp|telefone|contato|site",
        "questions": ["Qual é o WhatsApp?", "Qual é o telefone?", "Qual é o site?", "Como entrar em contato?"]
      },
      {
        "pattern": "hor[aá]rio|horarios|funcionamento|grade|agenda",
        "questions": ["Qual é o horário de funcionamento?", "Quais são os horários durante a semana?", "Abre aos sábados?", "Funciona aos domingos?"]
      },
      {
        "pattern": "plano|planos|mensal|semestral|anual",
        "questions": ["Quais planos estão disponíveis?", "Quanto custa o plano mensal?", "Existem planos semestrais?", "Existem planos anuais?"]
      },
      {
        "pattern": "valor|valores|pre[cç]o|precos|r\\$",
        "questions": ["Quais são os valores?", "Quais são os preços dos planos?"]
      },
      {
        "pattern": "black\\s*friday|promo[cç][aã]o|desconto|oferta",
        "questions": ["Existe promoção de Black Friday?", "Até quando vai a promoção?"]
      },
      {
        "pattern": "fisioterapia|sess[aã]o|sess[oõ]es|pacote",
        "questions": ["Quanto custa uma sessão de fisioterapia?", "Quanto custa o pacote com 5 sessões?", "Quanto custa o pacote com 10 sessões?"]
      },
      {
        "pattern": "pilates|bal[eé]|crossfit|funcional",
        "questions": ["Quais modalidades estão disponíveis?"]
      }
    ]
  },
  "domainCoverage": {
    "enabled": true,
    "entities": {
      "modalities": [
        { "label": "Crossfit", "patterns": ["crossfit"] },
        { "label": "Funcional", "patterns": ["funcional"] },
        { "label": "Balé", "patterns": ["bale", "ballet"] },
        { "label": "Pilates", "patterns": ["pilates"] },
        { "label": "Fisioterapia", "patterns": ["fisioterapia", "fisio"] }
      ]
    },
    "templates": {
      "business": ["O que é {{business}}?", "Quais serviços {{business}} oferece?", "Quais modalidades estão disponíveis?"],
      "hoursGeneric": ["Qual é o horário de funcionamento?", "Quais são os horários durante a semana?", "Abre aos sábados?", "Funciona aos domingos?"],
    "hoursByModality": ["Quais são os horários de {{modality}}?", "Como consultar a grade de horários de {{modality}}?"],
      "plans": ["Quais planos estão disponíveis?", "Quanto custa o plano mensal?", "Existem planos semestrais?", "Existem planos anuais?"],
      "pricingGeneric": ["Quais são os valores?", "Quais são os preços dos planos?"],
    "pricingByModality": ["Qual o valor de {{modality}}?"],
      "balletPricing": ["Qual o valor do balé 1x por semana?", "Qual o valor do balé 2x por semana?"],
      "physioPackages": ["Quanto custa uma sessão de fisioterapia?", "Quanto custa o pacote com 5 sessões?", "Quanto custa o pacote com 10 sessões?"],
      "promotions": ["Existe promoção de Black Friday?", "Até quando vai a promoção?", "Qual o valor promocional do pilates?"],
      "payment": ["Quais formas de pagamento são aceitas?", "Posso pagar via PIX?", "Qual é a chave PIX?", "Como enviar o comprovante?", "Para qual WhatsApp envio o comprovante?"],
      "contact": ["Qual é o WhatsApp?", "Qual é o telefone?", "Qual é o site?", "Como entrar em contato?"],
      "rules": ["Quais são as regras básicas?", "Quais dados devo informar no pagamento (nome do aluno etc.)?"]
    },
    "triggers": {
      "hours": ["horário", "horarios", "funcionamento", "grade"],
      "plans": ["plano", "planos", "mensal", "semestral", "anual"],
      "pricing": ["valor", "valores", "preço", "precos", "r$"],
      "promotions": ["black friday", "promo", "promoc", "desconto", "oferta"],
      "payment": ["pix", "comprovante", "pagamento", "pagar"],
      "contact": ["whatsapp", "telefone", "site", "contato"],
      "rules": ["comprovante", "nome do aluno", "nome do(a) aluno", "aluno", "enviar o comprovante", "envio do comprovante"]
    }
  },
  "contentBased": {
    "enabled": true,
    "minContentLength": 50,
    "actionVerbs": ["acesse", "clique", "selecione", "digite", "insira", "configure", "ativar", "desativar", "envie", "pague", "agende", "fale", "entre em contato"],
    "sentenceFilters": { "minLength": 20, "maxLength": 150 },
    "maxSentencesToProcess": 4,
    "questionTemplate": "Como {{action}}?",
    "fallbackEnabled": true,
    "fallbackMaxSentences": 3,
    "fallbackMinLength": 20,
    "fallbackMaxLength": 110
  },
  "deduplication": { "enabled": true, "similarityThreshold": 0.8, "normalizeForComparison": true },
  "limits": { "maxQuestionsPerDocument": 45, "maxQuestionsFromTitle": 2, "maxQuestionsFromKeywords": 25, "maxQuestionsFromContent": 10 }
}

