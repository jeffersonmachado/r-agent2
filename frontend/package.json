{
  "name": "chatbot-flow-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Editor visual de fluxo de chatbot baseado em React + Rete.js",
  "scripts": {
    "start": "VITE_CACHE_DIR=/tmp/r-agent2-vite vite --config vite.config.cjs",
    "test": "VITE_CACHE_DIR=/tmp/r-agent2-vite vitest --config vitest.config.mjs",
    "build": "VITE_CACHE_DIR=/tmp/r-agent2-vite vite build --config vite.config.cjs",
    "preview": "VITE_CACHE_DIR=/tmp/r-agent2-vite vite preview --config vite.config.cjs"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.1.5",
    "rete-auto-arrange-plugin": "^2.0.2",
    "rete-connection-plugin": "^2.0.5",
    "rete-connection-reroute-plugin": "^2.0.3",
    "rete-context-menu-plugin": "^2.0.6",
    "rete-minimap-plugin": "^2.0.3",
    "rete-react-plugin": "^2.1.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.0",
    "vitest": "^2.1.4"
  }
