{
  "id": "seed-platform-create-queue",
  "name": "Seed Plataforma - Criar Fila",
  "version": "1.0.0",
  "createdAt": "2026-01-02T00:00:00.000Z",
  "url": "http://localhost:5173",
  "steps": [
    {
      "type": "navigate",
      "url": "{{urls.frontend}}/queues",
      "waitFor": ".queue-manager, [data-testid='queues-page']",
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:00.000Z"
    },
    {
      "type": "wait",
      "condition": 2000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:01.000Z"
    },
    {
      "type": "fill",
      "selector": "input[placeholder*='fila'], input[placeholder*='Nome da fila'], .queue-manager-input",
      "value": "{{queue.name}}",
      "clear": true,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:02.000Z"
    },
    {
      "type": "wait",
      "condition": 500,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:03.000Z"
    },
    {
      "type": "click",
      "selector": "button:has-text('Criar'), button:has-text('➕'), [data-testid='create-queue-button']",
      "waitFor": ".queue-list, [data-testid='queue-list']",
      "timeout": 30000,
      "force": false,
      "timestamp": "2026-01-02T00:00:04.000Z"
    },
    {
      "type": "wait",
      "condition": 2000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:05.000Z"
    },
    {
      "type": "assert",
      "selector": ".queue-list, [data-testid='queue-list']",
      "exists": true,
      "message": "Fila criada com sucesso",
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:06.000Z"
    }
  ],
  "data": {
    "queue": {
      "name": "suporte"
    },
    "urls": {
      "frontend": "http://localhost:5173"
    }
  }
}

