[Unit]
Description=R-Agent2 RAG Service (Python FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/results/ria/r-agent2/rag-service
Environment="PATH=/opt/results/ria/r-agent2/rag-service/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/results/ria/r-agent2/rag-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
