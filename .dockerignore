# Arquivos e diretórios a serem ignorados no build Docker

# Dependências
node_modules/
**/node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Ambiente
.env
.env.local
.env.*.local
.env.*
*.env
!.env.example

# Testes e cobertura
coverage/
.nyc_output/
*.test.js
*.spec.js
test-results/
*.xml

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentação
*.md
!README.md
# A rota viva /api/qa-waves/docs/:type serve docs/roteiros e docs/diagrams/qa-waves
# em runtime (api/modules/qa-waves/routes.js). Sem esse subconjunto a rota responde
# 404 na imagem e a pagina /dev/qa-waves emite erros de console. O resto de docs/
# (31M) permanece fora da imagem.
docs/*
!docs/roteiros/
!docs/diagrams/
# Conteúdo lido em runtime pela API viva de dev-management
# (api/modules/dev-management/handleDevManagementRoutes.js). O diretório dev/
# (168M de artefatos de desenvolvimento) continua fora da imagem.
dev/
!dev Documentos/

# Dependências isoladas E2E / Cypress (não pertencem à imagem de produção)
frontend-e2e/node_modules/

# Evidências/artefatos de runtime (não pertencem à imagem de produção)
qa/release-evidence/
qa/smoke/
qa/*-report.json
qa/*-evidence.json
qa/runtime-governance-report.json
qa/system-validate-report.json
qa/deploy-report.json
qa-mesh/meshEvidence/
qa-mesh/meshHistory/
qa-mesh/isolated-run*/
qa-mesh/metrics.json
qa-mesh/meshReport.json
qa-mesh/repairPlan.json
qa-mesh/scheduler-state.json
qa-mesh/system-validate/
reports/
recordings/
replays/
.wwebjs_auth/
.wwebjs_cache/
api/data/wa_sessions/
rag-service/.coverage
rag-service/data/vector_store/
rag-service/data/adaptive_learning/
frontend/.vite/

# Backups ad-hoc
backups/
**/backups/
backup/
**/backup/
**/*.bkp
**/*.bak
**/*.backup

# Tokens e credenciais locais
.token.env
*.token.env
**/rpa-token.json
.tmp-*
**/.tmp-*
core/rpa/config/rpa-token.json
tests/rpa/config/rpa-token.json
rpa/config/rpa-token.json
.claude/
.codex
.codex/

# Scripts temporários promovíveis (qualquer tmp_* na raiz)
tmp_*

# Arquivos temporários
*.tmp
*.temp
.cache/
.temp/
tmp/
**/tmp/
runtime/

# Build artifacts
dist/
build/
*.zip
*.tar.gz

# Scripts de desenvolvimento
scripts/*.md
scripts/*.txt
scripts/*.json
tools/
!tools/
!tools/system/
!tools/system/**

# Testes
tests/
__tests__/
*.test.js
*.spec.js

# RPA runtime (necessário em produção)
# Re-inclui apenas o subset usado pelo backend (evita mandar todos os testes).
!tests/rpa/
!tests/rpa/**

# Helper usado pelo runtime RPA legado
!tests/helpers/
!tests/helpers/errorClassifier.js

# Outros
.editorconfig
.eslintrc*
.prettierrc*
tsconfig.json
jest.config.*
vitest.config.*
nodemon.json
