{
  "id": "seed-platform-create-flow",
  "name": "Seed Plataforma - Criar Fluxo",
  "version": "1.0.0",
  "createdAt": "2026-01-02T00:00:00.000Z",
  "url": "http://localhost:5173",
  "steps": [
    {
      "type": "navigate",
      "url": "{{urls.frontend}}/flows",
      "waitFor": ".flow-editor, [data-testid='flow-editor']",
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:00.000Z"
    },
    {
      "type": "wait",
      "condition": 2000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:01.000Z"
    },
    {
      "type": "click",
      "selector": "button:has-text('Novo Fluxo'), button:has-text('Criar Fluxo'), [data-testid='create-flow-button']",
      "waitFor": "input[name='flowName'], input[placeholder*='nome'], .flow-name-input",
      "timeout": 30000,
      "force": false,
      "timestamp": "2026-01-02T00:00:02.000Z"
    },
    {
      "type": "wait",
      "condition": 1000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:03.000Z"
    },
    {
      "type": "fill",
      "selector": "input[name='flowName'], input[placeholder*='nome'], .flow-name-input",
      "value": "{{flow.name}}",
      "clear": true,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:04.000Z"
    },
    {
      "type": "wait",
      "condition": 500,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:05.000Z"
    },
    {
      "type": "click",
      "selector": "button:has-text('Criar'), button:has-text('Salvar'), [data-testid='save-flow-button']",
      "waitFor": ".flow-canvas, .rete-editor, [data-testid='flow-canvas']",
      "timeout": 30000,
      "force": false,
      "timestamp": "2026-01-02T00:00:06.000Z"
    },
    {
      "type": "wait",
      "condition": 2000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:07.000Z"
    },
    {
      "type": "assert",
      "selector": ".flow-canvas, .rete-editor, [data-testid='flow-canvas']",
      "exists": true,
      "visible": true,
      "message": "Editor de fluxo aberto",
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:08.000Z"
    }
  ],
  "data": {
    "flow": {
      "name": "Fluxo de Boas-Vindas"
    },
    "urls": {
      "frontend": "http://localhost:5173"
    }
  }
}

