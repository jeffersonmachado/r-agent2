# Arquivos e diretórios a serem ignorados no build Docker

# Dependências
node_modules/
**/node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Ambiente
.env
.env.local
.env.*.local
*.env
!.env.example

# Testes e cobertura
coverage/
.nyc_output/
*.test.js
*.spec.js
test-results/
*.xml

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentação
*.md
!README.md
docs/
dev Documentos/

# Dependências isoladas E2E / Cypress (não pertencem à imagem de produção)
frontend-e2e/node_modules/

# Dumps e importações externas (não pertencem à imagem de produção)
remote-dumps/
remote-dumps2/

# Backups ad-hoc
frontend_backup/

# Tokens e credenciais locais
.token.env
*.token.env

# Scripts temporários promovíveis (qualquer tmp_* na raiz)
tmp_*

# Arquivos temporários
*.tmp
*.temp
.cache/
.temp/

# Build artifacts
dist/
build/
*.zip
*.tar.gz

# PM2
ecosystem.config.js
.pm2/

# Scripts de desenvolvimento
scripts/*.md
scripts/*.txt
scripts/*.json
tools/

# Testes
tests/
__tests__/
*.test.js
*.spec.js

# RPA runtime (necessário em produção)
# Re-inclui apenas o subset usado pelo backend (evita mandar todos os testes).
!tests/rpa/
!tests/rpa/**

# Helper usado pelo runtime RPA legado
!tests/helpers/
!tests/helpers/errorClassifier.js

# Outros
.editorconfig
.eslintrc*
.prettierrc*
tsconfig.json
jest.config.*
vitest.config.*
nodemon.json

