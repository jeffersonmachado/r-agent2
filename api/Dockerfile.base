FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Base pre-aquecida para reduzir tempo de rebuild da API:
# - ffmpeg (voz/PBX)
# - dependencias de sistema do Playwright
# - browser Chromium baixado em /ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Instala somente para baixar browsers/deps do Playwright na base.
# A aplicacao usa sua propria dependencia em node_modules.
RUN npm install -g playwright@1.40.0 && \
    playwright install --with-deps chromium

