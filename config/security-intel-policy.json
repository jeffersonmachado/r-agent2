{
  "$comment": "Política da capacidade RAP Version & Security Intelligence. Fonte única dos limiares de release, da exposição por serviço e da validade da base de advisories. Alterações aqui mudam veredito de gate — não é configuracao cosmetica.",
  "version": "1.0.0",
  "advisorySources": {
    "osv": {
      "enabled": true,
      "url": "https://api.osv.dev/v1/query",
      "maxAgeHoursBeforeStale": 72,
      "maxAgeHoursBeforeBlocking": 336
    },
    "cisa-kev": {
      "enabled": true,
      "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
      "maxAgeHoursBeforeStale": 168
    },
    "first-epss": {
      "enabled": true,
      "url": "https://api.first.org/data/v1/epss",
      "maxAgeHoursBeforeStale": 48
    }
  },
  "serviceExposure": {
    "frontend": "internet",
    "api": "internet",
    "asterisk": "partner",
    "rag-service": "internal",
    "postgres": "internal",
    "redis": "internal",
    "mcp-research": "internal",
    "api-host": "local",
    "engineering-runner": "development"
  },
  "defaultExposure": "unknown",
  "vectorIndex": {
    "$comment": "Check permanente de integridade do índice vetorial do RAG. recommendedMinVersion é DECISÃO DE PLATAFORMA (alinhar com as correções de HNSW/concorrência disponíveis upstream), não requisito do fornecedor. expectedDimensions = 384 (all-MiniLM-L6-v2). Ver docs/architecture/SECURITY_INTELLIGENCE.md.",
    "tableName": "rag_chunks",
    "columnName": "embedding",
    "recommendedMinVersion": "0.8.0",
    "expectedDimensions": 384,
    "maxNullEmbeddings": 0,
    "requireIndexValid": true,
    "requirePlannerUsesIndex": true,
    "measuredAt": "2026-10-08"
  },
  "scan": {
    "defaultScope": "direct",
    "maxComponentsPerRun": 5000,
    "componentBatchSize": 500
  },
  "releaseGate": {
    "blockOnSeverity": ["CRITICAL", "HIGH"],
    "blockOnDevDependencies": false,
    "blockWhenKevWithoutFix": true,
    "blockOnStaleAdvisoryBase": true,
    "requireSbomSnapshot": true,
    "requireValidSbom": true,
    "minCoveragePercent": 80,
    "waiverRequiresExpiry": true,
    "maxWaiverDays": 90
  }
}
