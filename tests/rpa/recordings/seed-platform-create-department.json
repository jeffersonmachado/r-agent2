{
  "id": "seed-platform-create-department",
  "name": "Seed Plataforma - Criar Departamento",
  "version": "1.0.0",
  "createdAt": "2026-01-02T00:00:00.000Z",
  "url": "http://localhost:5173",
  "steps": [
    {
      "type": "navigate",
      "url": "{{urls.frontend}}/departments",
      "waitFor": ".departments-page, [data-testid='departments-page']",
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:00.000Z"
    },
    {
      "type": "wait",
      "condition": 2000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:01.000Z"
    },
    {
      "type": "click",
      "selector": "button:has-text('Novo Departamento'), button:has-text('Criar'), [data-testid='create-department-button']",
      "waitFor": "input[name='name'], .department-form",
      "timeout": 30000,
      "force": false,
      "timestamp": "2026-01-02T00:00:02.000Z"
    },
    {
      "type": "wait",
      "condition": 1000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:03.000Z"
    },
    {
      "type": "fill",
      "selector": "input[name='name'], input[placeholder*='nome']",
      "value": "{{department.name}}",
      "clear": true,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:04.000Z"
    },
    {
      "type": "fill",
      "selector": "textarea[name='description'], textarea[placeholder*='descrição']",
      "value": "{{department.description}}",
      "clear": true,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:05.000Z"
    },
    {
      "type": "fill",
      "selector": "input[name='queueNames'], input[placeholder*='filas']",
      "value": "{{department.queueNames}}",
      "clear": true,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:06.000Z"
    },
    {
      "type": "wait",
      "condition": 500,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:07.000Z"
    },
    {
      "type": "click",
      "selector": "button:has-text('Criar'), button:has-text('Salvar'), button[type='submit']",
      "waitFor": ".departments-list, [data-testid='departments-list']",
      "timeout": 30000,
      "force": false,
      "timestamp": "2026-01-02T00:00:08.000Z"
    },
    {
      "type": "wait",
      "condition": 2000,
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:09.000Z"
    },
    {
      "type": "assert",
      "selector": ".departments-list, [data-testid='departments-list']",
      "exists": true,
      "message": "Departamento criado com sucesso",
      "timeout": 30000,
      "timestamp": "2026-01-02T00:00:10.000Z"
    }
  ],
  "data": {
    "department": {
      "name": "Atendimento Geral",
      "description": "Departamento de atendimento geral",
      "queueNames": "suporte, tecnico"
    },
    "urls": {
      "frontend": "http://localhost:5173"
    }
  }
}

