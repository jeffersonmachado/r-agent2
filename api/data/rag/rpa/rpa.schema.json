{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RPA Test Plan",
  "type": "object",
  "required": ["version", "type", "context", "steps", "assertions"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "type": {
      "type": "string",
      "enum": ["rpa_test_plan"]
    },
    "context": {
      "type": "object",
      "required": ["application", "mode"],
      "properties": {
        "application": { "type": "string" },
        "mode": { "type": "string", "enum": ["test-only"] }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "target"],
        "properties": {
          "action": { "type": "string" },
          "target": { "type": "string" },
          "value": { "type": "string" },
          "timeout": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "selector": { "type": "string" },
          "value": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

