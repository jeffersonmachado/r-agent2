{
  "name": "chatbot-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Engine de fluxo de chatbot (Node.js) com execução determinística e replay.",
  "scripts": {
    "test": "npm run test:unit && npm run test:flow && npm run test:rpa",
    "test:unit": "jest tests/unit",
    "test:flow": "jest tests/flow",
    "test:data": "jest tests/data",
    "test:scripts": "jest tests/scripts",
    "test:rpa": "node tools/rpa/run-all.js",
    "test:rpa:jest": "jest tests/rpa",
    "test:ai-governance": "jest tests/ai-governance",
    "test:contracts": "jest tests/contracts",
    "test:governance": "jest tests/governance",
    "test:ci": "jest tests/ci",
    "test:runtime": "jest tests/runtime",
    "test:organizational": "jest tests/organizational",
    "test:stress": "jest tests/stress",
    "test:system": "jest tests/contracts tests/governance tests/ci tests/runtime tests/organizational tests/stress",
    "qa": "node qa/qaRunner.js",
    "system:validate": "node tools/system/validate.js",
    "system:checklist": "node tools/system/checklist.js",
    "test:rpa:record": "node tests/rpa/record.js",
    "rpa:demo": "node tests/rpa/demo.js",
    "rpa:seed": "node tests/rpa/seedPlatformRPA.js",
    "rpa:seed:completo": "node tests/rpa/seedPlatformCompleto.js --yes",
    "rpa:seed:debug": "node tests/rpa/seedPlatformDebug.js",
    "rpa:seed:replay": "node tests/rpa/seedCompletoComReplay.js",
    "rpa:seed:executar": "node tests/rpa/executarSeedComReplay.js",
    "rpa:seed:gravar": "node tests/rpa/seedPlatformGravar.js",
    "rpa:replay:ver": "node tests/rpa/verReplaySeed.js",
    "rpa:replay:gerar": "node tests/rpa/gerarReplayDetalhado.js",
    "test:all": "jest",
    "autotest": "node scripts/autotest.js",
    "check:green": "node scripts/check-green.js",
    "seed:test": "node tests/seeds/seedTestData.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "start": "node api/server.js",
    "start:frontend": "cd frontend && npm start",
    "start:api": "node api/server.js",
    "dev": "./scripts/start-dev.sh",
    "dev:api": "./scripts/start-dev-nodemon.sh",
    "dev:api-only": "nodemon api/server.js",
    "dev:frontend": "cd frontend && npm start",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:api": "pm2 start ecosystem.config.js --only r-agent2-api",
    "pm2:start:frontend": "pm2 start ecosystem.config.js --only r-agent2-frontend",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "prod": "pm2 start ecosystem.config.js --env production",
    "prod:stop": "pm2 stop ecosystem.config.js",
    "prod:restart": "pm2 restart ecosystem.config.js",
    "zip": "./scripts/generate-zip.sh",
    "zip:all": "./scripts/generate-zip.sh --include-node-modules --include-coverage --include-dist",
    "zip:api": "./scripts/generate-zip.sh -i 'api/**' -i 'package.json' -i 'package-lock.json' -n api-only.zip",
    "zip:frontend": "./scripts/generate-zip.sh -i 'frontend/**' -i 'package.json' -i 'package-lock.json' -n frontend-only.zip"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "uuid": "^9.0.0",
    "ws": "^8.18.3",
    "openai": "^4.20.0",
    "@anthropic-ai/sdk": "^0.20.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "pm2": "^5.3.0",
    "@playwright/test": "^1.40.0",
    "playwright": "^1.40.0"
  }
}
