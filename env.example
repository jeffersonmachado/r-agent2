# ============================================================================
# .env — Variáveis de ambiente do Results Autonomous Platform (RAP)
#
# SETUP:
#   cp env.example .env
#   # Preencha o ENCRYPTION_KEY obrigatório; demais são opcionais.
#
# CONFIG PRINCIPAL: api/data/config.json
#   cp api/data/config.example.json api/data/config.json
#   # Edite api/data/config.json para ajustar ports, integrações e features.
#
# OBSERVAÇÃO: ENV é suportado como fallback para retrocompatibilidade.
#   Para ambientes novos, prefira api/data/config.json.
# ============================================================================

# ============================================================================
# CRIPTOGRAFIA DE SEGREDOS (OBRIGATÓRIO para salvar credenciais de IA)
# ============================================================================
# A API usa ENCRYPTION_KEY para criptografar segredos no banco (ex.: API keys).
# Deve ser exatamente 32 bytes em base64.
#
# Gerar localmente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ou:
#   openssl rand -base64 32
#
# IMPORTANTE: Não troque esta chave depois que já existirem segredos salvos,
# senão não será possível descriptografá-los.
ENCRYPTION_KEY=

# ============================================================================
# RUNTIME — NODE_ENV e PORTS (fallback; preferir config.json)
# ============================================================================
# NODE_ENV=development
# API_PORT=3000
# FRONTEND_PORT=8080
# VITE_API_BASE_URL=http://localhost:3000

# ============================================================================
# BANCO DE DADOS (obrigatório se não configurado em config.json)
# ============================================================================
# DATABASE_URL=postgres://usuario:senha@localhost:5432/r_agent2

# ============================================================================
# WHATSAPP / WEBHOOKS (opcional; configurable via config.json)
# ============================================================================
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0
# WHATSAPP_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID
# WHATSAPP_ACCESS_TOKEN=SEU_ACCESS_TOKEN
# WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao_webhook
# WHATSAPP_QR_PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# PUPPETEER_CACHE_DIR=/app/.cache/puppeteer

# ============================================================================
# RATE LIMITING (Redis — fallback; preferir config.json rateLimit.redis)
# ============================================================================
# REDIS_URL=redis://localhost:6379
# RATE_LIMIT_REDIS_URL=redis://localhost:6379

# ============================================================================
# SCRAPING (opcionais — remover fallback silencioso exige config explícita)
# ============================================================================
# SCRAPING_ALLOW_DEGRADED=false     # false = falha explícita se cheerio ausente
# USE_PLAYWRIGHT=false
# ENABLE_SCRAPING_REPLAY=false
# ENABLE_SCRAPING_RECORDING=false

# ============================================================================
# PBX LEGADO (Ripabx / r-pbx) — opcional
# ============================================================================
# PBX_LEGACY_ROOT=/opt/results/telefonia/ripabx
# PBX_MARIADB_URL=mysql://resultsdba:*****@ripabx-mariadb:3306/results
