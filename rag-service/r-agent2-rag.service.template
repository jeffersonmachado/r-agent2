[Unit]
Description=R-Agent2 RAG Service (Python FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=%RAG_SERVICE_DIR%
Environment="PATH=%RAG_SERVICE_DIR%/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%RAG_SERVICE_DIR%/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
