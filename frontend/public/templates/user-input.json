{
  "id": "user-input",
  "name": "Coleta de Dados",
  "description": "Fluxo que coleta informações do usuário com fallback integrado",
  "icon": "📝",
  "flow": {
    "tenantId": "<tenant-id>",
    "id": "user-input",
    "name": "Coleta de Dados",
    "version": 1,
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "config": {},
        "next": "welcome"
      },
      {
        "id": "welcome",
        "type": "message",
        "config": {
          "text": "Olá! Vamos começar coletando algumas informações."
        },
        "next": "collect-name"
      },
      {
        "id": "collect-name",
        "type": "user_input",
        "config": {
          "variable": "user_name"
        },
        "next": "confirm"
      },
      {
        "id": "confirm",
        "type": "message",
        "config": {
          "text": "Obrigado! Seu nome foi registrado."
        },
        "next": "fallback"
      },
      {
        "id": "fallback",
        "type": "fallback",
        "config": {
          "maxAttempts": 3,
          "confidenceThreshold": 0.75,
          "enableEmotionCheck": true,
          "escalationMode": "ticket",
          "allowReturnToBot": true,
          "queue": "default",
          "safeReturnNode": "welcome"
        },
        "next": {
          "retry": "collect-name",
          "options": "collect-name",
          "human": "end",
          "end": "end"
        }
      },
      {
        "id": "end",
        "type": "end",
        "config": {},
        "next": null
      }
    ],
    "metadata": {}
  }
}

