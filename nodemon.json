{
  "watch": [
    "api",
    "engine"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules",
    "frontend",
    "logs",
    "*.test.js",
    "*.spec.js",
    "api/data/agents.json",
    "api/data/audit.json",
    "api/data/departments.json",
    "api/data/documents.json",
    "api/data/flows.json",
    "api/data/queues.json",
    "api/data/quickReplies.json",
    "api/data/rag_audit.json",
    "api/data/rag_documents.json",
    "api/data/rag_prompts.json",
    "api/data/rag_validation_rules.json",
    "api/data/sessions.json",
    "api/data/webhooks.json",
    "api/data/test/**/*.json"
  ],
  "exec": "node api/server.js",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "restartable": "rs"
}

