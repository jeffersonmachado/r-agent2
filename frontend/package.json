{
  "name": "chatbot-flow-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Editor visual de fluxo de chatbot baseado em React + Rete.js",
  "scripts": {
    "start": "VITE_CACHE_DIR=/tmp/r-agent2-vite vite --configLoader runner --config vite.config.mjs",
    "install:base": "npm ci --no-audit --no-fund",
    "build": "VITE_CACHE_DIR=/tmp/r-agent2-vite vite build --configLoader runner --config vite.config.mjs",
    "test": "VITE_CACHE_DIR=/tmp/r-agent2-vite vitest run --config vitest.config.mjs",
    "test:unit": "VITE_CACHE_DIR=/tmp/r-agent2-vite vitest run --config vitest.config.mjs",
    "test:e2e": "npm --prefix ../frontend-e2e run test:e2e",
    "smoke": "npm --prefix .. run frontend:smoke",
    "preview": "VITE_CACHE_DIR=/tmp/r-agent2-vite vite preview --configLoader runner --config vite.config.mjs"
  },
  "dependencies": {
    "bpmn-js": "^18.13.1",
    "bpmn-moddle": "^10.0.0",
    "browser-image-compression": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.1.5",
    "rete-auto-arrange-plugin": "^2.0.2",
    "rete-connection-plugin": "^2.0.5",
    "rete-connection-reroute-plugin": "^2.0.3",
    "rete-context-menu-plugin": "^2.0.6",
    "rete-minimap-plugin": "^2.0.3",
    "rete-react-plugin": "^2.1.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.23",
    "babel-jest": "^30.2.0",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.0.11",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^2.1.4"
  }
}
