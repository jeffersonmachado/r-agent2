{
  "watch": [
    "api",
    "engine"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules",
    "frontend",
    "logs",
    "tests/rpa/flows",
    "tests/rpa/flows/**",
    "tests/rpa/reports",
    "tests/rpa/reports/**",
    "tests/rpa/replay",
    "tests/rpa/replay/**",
    "tests/rpa/screenshots",
    "tests/rpa/screenshots/**",
    "tests/rpa/.cache",
    "tests/rpa/.cache/**",
    "*.test.js",
    "*.spec.js"
  ],
  "exec": "node api/server.js",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "restartable": "rs"
}

